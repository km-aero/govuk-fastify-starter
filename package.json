{
  "name": "govuk-next-starter",
  "version": "1.0.0",
  "description": "Next.js + TypeScript starter project for GOV.UK Design System compliant websites",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx/esm --watch src/server.ts",
    "build": "tsc && npm run build:css",
    "start": "node --env-file=.env dist/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "node --env-file=.env --import tsx/esm prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate && npm run copy-assets",
    "copy-assets": "node scripts/copy-govuk-assets.js",
    "build:css": "sass --load-path=node_modules src/styles/main.scss public/stylesheets/main.css"
  },
  "dependencies": {
    "@fastify/env": "^5.0.3",
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^9.0.0",
    "@fastify/view": "^11.1.1",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "fastify": "^5.7.2",
    "govuk-frontend": "^5.14.0",
    "nunjucks": "^3.2.4",
    "pino": "^10.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.58.0",
    "@types/govuk-frontend": "^5.11.0",
    "@types/node": "^22.19.7",
    "@types/nunjucks": "^3.2.6",
    "@types/pino": "^7.0.4",
    "axe-core": "^4.11.1",
    "eslint": "^9.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.3.0",
    "sass": "^1.97.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
