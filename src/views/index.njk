{% extends "layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageTitle %}
  {{ content.title }} - {{ serviceName }} - GOV.UK
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ content.heading }}</h1>
      
      <p class="govuk-body">
        {{ content.intro }}
      </p>

      <p class="govuk-body">
        {{ content.featuresIntro }}
      </p>

      <ul class="govuk-list govuk-list--bullet">
        {% for feature in content.featuresListValues %}
          <li>{{ feature }}</li>
        {% endfor %}
      </ul>

      {{ govukButton({
        text: content.startButton,
        href: "/example-form",
        isStartButton: true
      }) }}

    </div>
  </div>
{% endblock %}
