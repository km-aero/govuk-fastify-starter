// =============================================================================
// PRISMA SCHEMA
// =============================================================================
// This file defines the database schema for the GOV.UK Next.js Starter project.
// It uses PostgreSQL as the database provider and Prisma as the ORM.
// =============================================================================

// -----------------------------------------------------------------------------
// Generator Configuration
// -----------------------------------------------------------------------------
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

// -----------------------------------------------------------------------------
// Datasource Configuration
// -----------------------------------------------------------------------------
// Uses PostgreSQL. Connection is configured via prisma.config.ts for Prisma 7
datasource db {
  provider = "postgresql"
}

// =============================================================================
// MODELS
// =============================================================================

// -----------------------------------------------------------------------------
// ContactSubmission Model
// -----------------------------------------------------------------------------
// Stores contact form submissions with explicit columns for each field.
// This allows efficient querying and filtering by individual fields.
model ContactSubmission {
  /// Unique identifier for the submission (CUID)
  id        String   @id @default(cuid())

  /// Full name of the person submitting
  fullName  String

  /// Email address for replies
  email     String

  /// Subject/category of the enquiry
  subject   String

  /// The message content
  message   String

  /// Reference number for the submission (for user reference)
  reference String   @unique @default(uuid())

  /// Timestamp when the submission was created
  createdAt DateTime @default(now())

  /// Timestamp when the submission was last updated
  updatedAt DateTime @updatedAt

  // Indexes for common queries
  @@index([email])
  @@index([subject])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// FeedbackSubmission Model
// -----------------------------------------------------------------------------
// Stores feedback form submissions with explicit columns for each field.
model FeedbackSubmission {
  /// Unique identifier for the submission (UUID)
  id              String   @id @default(uuid())

  /// Satisfaction rating
  satisfaction    String

  /// Suggested improvements (optional)
  improvements    String?

  /// Whether user would recommend the service
  wouldRecommend  String

  /// Email address (optional, for follow-up)
  email           String?

  /// Reference number for the submission
  reference       String   @unique @default(uuid())

  /// Timestamp when the submission was created
  createdAt       DateTime @default(now())

  /// Timestamp when the submission was last updated
  updatedAt       DateTime @updatedAt

  // Indexes for common queries
  @@index([satisfaction])
  @@index([createdAt])
}
